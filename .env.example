# SCAR configuration. Copy to .env (never commit it) or set these as environment variables.
# Non-secret settings can also live in %APPDATA%\SCAR\config.toml (`scar config set KEY VALUE`).
# Precedence: CLI flags > environment > .env > config.toml > defaults.

# Preferred reasoning provider id (groq, gemini, cerebras, openrouter, mistral, nvidia, cloudflare, huggingface, anthropic, openai, ollama, llamacpp) or `auto`.
# SCAR_LLM_PROVIDER=auto
# Model for SCAR_LLM_PROVIDER (otherwise the catalog's candidates).
# SCAR_LLM_MODEL=
# Ordered extra candidates, `provider[:model]`, comma-separated.
# SCAR_LLM_FALLBACKS=
# Provider for quick/small tasks (chat replies).
# SCAR_FAST_LLM_PROVIDER=auto
# Model for the fast provider.
# SCAR_FAST_LLM_MODEL=
# Preferred vision provider or `auto`.
# SCAR_VISION_PROVIDER=auto
# Vision model override.
# SCAR_VISION_MODEL=
# `auto`, `groq` or `faster-whisper`.
# SCAR_STT_PROVIDER=auto
# STT model override.
# SCAR_STT_MODEL=
# faster-whisper size (tiny, base, small, medium).
# SCAR_LOCAL_STT_MODEL=base
# `auto`, `azure-speech`, `edge-tts`, `sapi`, `kokoro` or `none`.
# SCAR_TTS_PROVIDER=auto
# Voice name (e.g. en-US-AriaNeural, or part of a SAPI voice name).
# SCAR_TTS_VOICE=
# Enable hands-free wake-word mode in voice sessions.
# SCAR_VOICE_ENABLED=false
# openWakeWord model: hey_jarvis, alexa, hey_mycroft, hey_rhasspy.
# SCAR_WAKE_WORD=hey_jarvis
# Wake-word score threshold (0-1).
# SCAR_WAKE_WORD_THRESHOLD=0.5
# Push-to-talk global hotkey (pynput syntax).
# SCAR_PTT_HOTKEY=<ctrl>+<alt>+<space>
# Microphone: index or name substring (empty = default).
# SCAR_MIC_DEVICE=
# Speaker: index or name substring (empty = default).
# SCAR_SPEAKER_DEVICE=
# Seconds of follow-up listening after a reply.
# SCAR_VOICE_SESSION_TIMEOUT=30.0
# Longest single utterance.
# SCAR_MAX_UTTERANCE_SECONDS=20.0
# Seconds SCAR listens for an approval answer.
# SCAR_VOICE_APPROVAL_WINDOW=8.0
# `fastembed` (local) or `none`.
# SCAR_EMBEDDINGS_PROVIDER=fastembed
# fastembed model id.
# SCAR_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# `auto`, `brave`, `tavily`, `searxng`, `ddgs`.
# SCAR_SEARCH_PROVIDER=auto
# Base URL of a SearXNG instance.
# SCAR_SEARXNG_URL=
# `faiss` (hybrid) or `fts_only` (keyword only, no embeddings).
# SCAR_MEMORY_BACKEND=faiss
# llama.cpp server URL to reuse or start.
# SCAR_LOCAL_LLM_URL=http://127.0.0.1:8080
# Path to llama-server.exe (default: PATH).
# SCAR_LOCAL_LLM_SERVER_BIN=
# GGUF model SCAR starts llama-server with.
# SCAR_LOCAL_LLM_MODEL_PATH=
# Context size for the managed server.
# SCAR_LOCAL_LLM_CTX=16384
# GGUF vision model.
# SCAR_LOCAL_VLM_MODEL_PATH=
# Vision projector (mmproj) for the VLM.
# SCAR_LOCAL_VLM_MMPROJ_PATH=
# Ollama server URL (used if running).
# SCAR_OLLAMA_URL=http://127.0.0.1:11434
# Ask before every action with side effects.
# SCAR_REQUIRE_APPROVAL=false
# 0 chat only · 1 suggest · 2 auto LOW · 3 auto LOW+MEDIUM (default) · 4 HIGH via explicit rules/grants.
# SCAR_AUTONOMY_LEVEL=3
# Allow window/input/app control tools.
# SCAR_PC_CONTROL_ENABLED=true
# Allow browser tools.
# SCAR_BROWSER_ENABLED=true
# Allow terminal/dev tools.
# SCAR_TERMINAL_ENABLED=true
# Folders SCAR may work in (`;`-separated). Default: your user folder.
# SCAR_ALLOWED_ROOTS=
# Extra protected folders (writes CRITICAL, reads HIGH).
# SCAR_PROTECTED_PATHS=
# Report side-effecting actions instead of doing them.
# SCAR_DRY_RUN=false
# Emergency-stop hotkey.
# SCAR_KILL_SWITCH_HOTKEY=<ctrl>+<alt>+<shift>+k
# Seconds before an unanswered approval is denied.
# SCAR_APPROVAL_TIMEOUT=300.0
# File count above which bulk operations escalate one risk level.
# SCAR_BULK_THRESHOLD=20
# MiB of VRAM local models may use.
# SCAR_MAX_LOCAL_VRAM=6144
# MiB of RAM local models may use.
# SCAR_MAX_LOCAL_RAM=8192
# Don't start GPU inference above this GPU utilisation (%).
# SCAR_GPU_USAGE_THRESHOLD=70
# `minimal`, `balanced`, `performance`: concurrency and monitor limits.
# SCAR_BACKGROUND_TASK_POLICY=balanced
# Seconds before idle local models/components are unloaded.
# SCAR_MODEL_IDLE_TIMEOUT=300.0
# `never`, `fallback_only` (default), `prefer`, `always`.
# SCAR_LOCAL_INFERENCE_POLICY=fallback_only
# On battery below this %, no GPU inference.
# SCAR_BATTERY_SAVER_THRESHOLD=25
# `open`, `balanced` (default: redact before cloud), `strict` (sensitive classes local only).
# SCAR_PRIVACY_MODE=balanced
# Per data class: `screen=local_only,email=cloud_redacted` (classes: general, screen, audio, email, messages, files, contacts, memory, clipboard).
# SCAR_PRIVACY_OVERRIDES=
# Max agent steps per task.
# SCAR_MAX_STEPS=40
# Max retries per step.
# SCAR_MAX_RETRIES=3
# Wall-clock limit per task (s).
# SCAR_TASK_TIMEOUT=900.0
# Token budget per task.
# SCAR_TASK_TOKEN_BUDGET=400000
# Default command timeout (s).
# SCAR_COMMAND_TIMEOUT=120.0
# Hard ceiling for commands (s).
# SCAR_COMMAND_TIMEOUT_MAX=1800.0
# Captured output kept in memory per stream; the rest goes to an artifact.
# SCAR_OUTPUT_CAP_BYTES=65536
# Concurrent tasks.
# SCAR_MAX_CONCURRENT_TASKS=4
# Concurrent sub-agents per task.
# SCAR_MAX_SUBAGENTS=3
# `auto`, `chrome`, `msedge`, `chromium`.
# SCAR_BROWSER_CHANNEL=auto
# Run the SCAR browser headless.
# SCAR_BROWSER_HEADLESS=false
# Where browser downloads go (never executed).
# SCAR_DOWNLOADS_DIR=
# Path to the Google OAuth client JSON (Desktop app).
# SCAR_GOOGLE_OAUTH_CLIENT_FILE=
# Azure app (client) id for Microsoft Graph.
# SCAR_MS_CLIENT_ID=
# `common`, `consumers`, `organizations` or a tenant id.
# SCAR_MS_TENANT=common
# `auto`, `gmail`, `outlook`, `imap`.
# SCAR_EMAIL_PROVIDER=auto
# IMAP server.
# SCAR_IMAP_HOST=
# IMAP port.
# SCAR_IMAP_PORT=993
# IMAP/SMTP user name.
# SCAR_IMAP_USER=
# SMTP server.
# SCAR_SMTP_HOST=
# SMTP port.
# SCAR_SMTP_PORT=587
# `auto`, `google`, `outlook`, `local`.
# SCAR_CALENDAR_PROVIDER=auto
# Telegram API id (user client).
# SCAR_TELEGRAM_API_ID=
# Default Discord channel id.
# SCAR_DISCORD_DEFAULT_CHANNEL=
# Opt-in WhatsApp Desktop provider (UI automation).
# SCAR_WHATSAPP_DESKTOP_ENABLED=false
# WhatsApp Cloud API phone number id.
# SCAR_WHATSAPP_PHONE_NUMBER_ID=
# Only chat live tests may send to.
# SCAR_TEST_TELEGRAM_CHAT=
# Only address live tests may email.
# SCAR_TEST_EMAIL_TO=
# Only channel live tests may post to.
# SCAR_TEST_DISCORD_CHANNEL=
# DEBUG/INFO/WARNING/ERROR.
# SCAR_LOG_LEVEL=INFO
# Data folder (default %LOCALAPPDATA%\SCAR).
# SCAR_DATA_DIR=
# Enable live desktop tests (tests only).
# SCAR_LIVE_TESTS=false
# Show internals.
# SCAR_DEBUG=false
# Show tools and timings.
# SCAR_VERBOSE=false
# IANA zone for reminders (default: system).
# SCAR_TIMEZONE=

# ---- Secrets (prefer `scar config set-secret NAME`, stored in Windows Credential Manager) ----
# Optional paid provider
ANTHROPIC_API_KEY=
# Azure Speech (also AZURE_SPEECH_REGION)
AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION
AZURE_SPEECH_REGION=
# Brave Search
BRAVE_API_KEY=
# Cerebras
CEREBRAS_API_KEY=
# CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Workers AI (also set CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_API_TOKEN=
# Discord bot
DISCORD_BOT_TOKEN=
# Google AI Studio key (free tier; see data terms)
GEMINI_API_KEY=
# GitHub fine-grained token for issues/PRs/CI
GITHUB_TOKEN=
# Alternative name for the Gemini key
GOOGLE_API_KEY=
# Groq (free tier: reasoning + Whisper STT)
GROQ_API_KEY=
# Hugging Face Inference Providers
HF_TOKEN=
# Mistral La Plateforme
MISTRAL_API_KEY=
# NVIDIA API catalog
NVIDIA_API_KEY=
# Optional paid provider
OPENAI_API_KEY=
# OpenRouter (:free models)
OPENROUTER_API_KEY=
# IMAP app password
SCAR_IMAP_PASSWORD=
# SMTP app password
SCAR_SMTP_PASSWORD=
# Tavily search
TAVILY_API_KEY=
# Telegram user client (with SCAR_TELEGRAM_API_ID)
TELEGRAM_API_HASH=
# Telegram bot
TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
