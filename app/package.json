{
  "name": "scar-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:types": "json2ts -i src/api/schema.json -o src/api/types.ts --bannerComment \"/* Generated from the runtime's Pydantic models by scripts/gen_api_types.py + json2ts. Do not edit. */\" --unreachableDefinitions",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-autostart": "2.6.0",
    "@tauri-apps/plugin-global-shortcut": "2.4.0",
    "@tauri-apps/plugin-notification": "2.5.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
