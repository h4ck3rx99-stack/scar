{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ApprovalAnswer": {
      "additionalProperties": false,
      "description": "A user's decision on one pending approval. ``args_hash`` must match the pending request (the UI echoes what it\ndisplayed), and ``user_gesture`` records that it came from a trusted click/keypress on the approval card.",
      "properties": {
        "args_hash": {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        },
        "response": {
          "enum": [
            "allow_once",
            "allow_task",
            "allow_session",
            "allow_timed",
            "allow_always",
            "deny",
            "deny_always"
          ],
          "type": "string"
        },
        "typed_confirmation": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_gesture": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "response",
        "args_hash"
      ],
      "title": "ApprovalAnswer",
      "type": "object"
    },
    "ApprovalRequested": {
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
