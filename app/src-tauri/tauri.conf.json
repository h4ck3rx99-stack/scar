{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCAR",
  "version": "1.0.0",
  "identifier": "app.scar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SCAR",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "quickbar",
        "title": "SCAR Quick Bar",
        "url": "quickbar.html",
        "width": 680,
        "height": 88,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "visible": false
      },
      {
        "label": "indicator",
        "title": "SCAR is controlling your computer",
        "url": "indicator.html",
        "width": 760,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SCAR",
    "copyright": "SCAR contributors (MIT)",
    "category": "Productivity",
    "shortDescription": "SCAR \u2014 an AI operator for your Windows computer",
    "longDescription": "SCAR opens apps and projects, works with files, runs and fixes tests, browses, researches and keeps an eye on things, asking before anything risky.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray-*.png": "icons/",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "runtime/*": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
